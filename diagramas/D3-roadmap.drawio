        <mxCell id="r1" value="R1 — MVP&#10;&#10;Sede piloto&#10;5 sprints · 10 semanas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C9DAF8;strokeColor=#3B6FD4;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1">
