        </mxCell>
        <mxCell id="r4d" value="CRITERIO DE PASO: la proporción de accesos desde dispositivo móvil debe justificar el costo frente a una versión web adaptable. Comprometer una aplicación nativa antes de verificarlo carecería de fundamento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#C9A227;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
