        <mxCell id="r4" value="R4 — Aplicación móvil&#10;&#10;Alcance por definir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#999999;strokeWidth=2;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="1">
