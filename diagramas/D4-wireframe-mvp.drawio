        <mxCell id="p3n" value="El historial muestra la gestión de citas.&#10;No expone contenido clínico: requiere&#10;autorización y rol diferenciado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#DDDDDD;fontSize=8;align=left;spacingLeft=8;" vertex="1" parent="1">
